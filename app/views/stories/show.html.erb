<% content_for :title, @story.title %>
<% content_for :meta_description, @analysis&.summary.presence || @story.excerpt %>

<article class="mx-auto max-w-3xl">
  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">
    <%= @story.source_name %> · <%= story_timestamp(@story) %>
  </p>
  <h1 class="font-display mt-3 text-3xl leading-tight text-olive-deep sm:text-4xl"><%= @story.title %></h1>

  <p class="mt-4 text-sm text-ink/65">
    We do not reprint the article. <%= link_to "Read the original at #{@story.source_name}", @story.url, class: "font-medium text-olive underline decoration-olive/30 underline-offset-4 hover:decoration-olive", target: "_blank", rel: "noopener noreferrer" %>.
  </p>

  <% if @analysis %>
    <div class="mt-5 flex flex-wrap gap-1.5">
      <% @analysis.theme_list.each do |theme| %>
        <%= theme_chip(theme) %>
      <% end %>
    </div>

    <% if @analysis.stretch? || @analysis.caveat.present? %>
      <aside class="mt-6 rounded-lg border border-amber-800/25 bg-amber-50 px-4 py-3 text-sm text-amber-950">
        <p class="font-semibold">Tentative link</p>
        <p class="mt-1 leading-relaxed">
          <%= @analysis.caveat.presence || "This mapping is a stretch. Scripture is not a decoder ring for this headline." %>
        </p>
      </aside>
    <% end %>

    <section class="mt-8">
      <h2 class="font-display text-xl text-olive-deep">Our reading</h2>
      <div class="mt-3 space-y-4 text-base leading-7 text-ink/90">
        <% @analysis.summary.to_s.split(/\n\n+/).each do |para| %>
          <p><%= para %></p>
        <% end %>
      </div>
    </section>

    <% if @analysis.connection_list.any? %>
      <section class="mt-10">
        <h2 class="font-display text-xl text-olive-deep">Connections</h2>
        <ul class="mt-4 grid gap-4">
          <% @analysis.connection_list.each do |connection| %>
            <li class="rounded-lg border border-olive/10 bg-white/70 px-4 py-3">
              <p class="text-sm font-semibold text-olive">
                <%= connection["verse_ref"] %>
                <% if connection["stretch"] %>
                  <span class="ml-2 text-xs font-medium uppercase tracking-wide text-amber-800">stretch</span>
                <% end %>
              </p>
              <p class="mt-1 text-sm leading-relaxed text-ink/80"><%= connection["explanation"] %></p>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <section class="mt-10">
      <h2 class="font-display text-xl text-olive-deep">World English Bible</h2>
      <% if @verses.any? %>
        <ul class="mt-4 grid gap-5">
          <% @verses.each do |verse| %>
            <li class="border-l-2 border-gold/60 pl-4">
              <p class="text-sm font-semibold text-olive"><%= verse.ref %></p>
              <% if verse.found %>
                <blockquote class="font-display mt-1 text-lg leading-relaxed text-ink/90">“<%= verse.text %>”</blockquote>
              <% else %>
                <p class="mt-1 text-sm text-ink/65">Not in the local WEB index. Look this reference up in a full Bible — the citation still stands.</p>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-ink/65">No verse references were returned for this story.</p>
      <% end %>
    </section>

    <% if @analysis.prophecy_relevance.to_f >= 0.3 %>
      <p class="mt-8 text-xs uppercase tracking-wide text-ink/55">
        Prophecy relevance (model estimate): <%= number_with_precision(@analysis.prophecy_relevance * 100, precision: 0) %>%
        <% if @analysis.stretch? %> · marked as a stretch<% end %>
      </p>
    <% end %>
  <% else %>
    <div class="mt-8 rounded-lg border border-dashed border-olive/25 bg-white/50 px-4 py-8 text-sm text-ink/70">
      Analysis has not been published for this story yet.
    </div>
  <% end %>

  <p class="mt-12">
    <%= link_to "← Back to the feed", root_path, class: "text-sm font-medium text-olive hover:underline" %>
  </p>
</article>
