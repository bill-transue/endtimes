<% content_for :title, "Admin" %>

<div class="flex flex-col gap-6">
  <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">Editors</p>
      <h1 class="font-display mt-1 text-3xl text-olive-deep">Story queue</h1>
      <p class="mt-2 max-w-xl text-sm text-ink/70">Override the selector. Publish what actually deserves a public reading; hold stretch takes; reject junk or duplicates.</p>
    </div>
    <nav class="flex flex-wrap gap-2 text-sm">
      <%= link_to "All", admin_stories_path, class: admin_filter_class(nil) %>
      <% Story.statuses.keys.each do |status| %>
        <%= link_to status.humanize, admin_stories_path(status: status), class: admin_filter_class(status) %>
      <% end %>
    </nav>
  </header>

  <% if @stories.empty? %>
    <div class="rounded-xl border border-dashed border-olive/25 bg-white/60 px-6 py-12 text-center text-ink/70">
      No stories in this view. Run ingest or seed the database.
    </div>
  <% else %>
    <div class="overflow-x-auto rounded-xl border border-olive/15 bg-white/80">
      <table class="min-w-full text-left text-sm">
        <thead class="border-b border-olive/10 bg-olive-deep text-parchment">
          <tr>
            <th class="px-3 py-2 font-medium">Story</th>
            <th class="px-3 py-2 font-medium">Status</th>
            <th class="px-3 py-2 font-medium">Themes</th>
            <th class="px-3 py-2 font-medium">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @stories.each do |story| %>
            <tr class="border-b border-olive/10 align-top">
              <td class="px-3 py-3">
                <p class="font-medium text-olive-deep"><%= story.title %></p>
                <p class="text-xs text-ink/55"><%= story.source_name %> · <%= story_timestamp(story) %></p>
                <% if story.biblical_analysis&.stretch? %>
                  <p class="mt-1 text-xs text-amber-800">Stretch / weak prophecy link</p>
                <% end %>
              </td>
              <td class="px-3 py-3 whitespace-nowrap"><%= story.status.humanize %></td>
              <td class="px-3 py-3">
                <div class="flex flex-wrap gap-1">
                  <% Array(story.biblical_analysis&.theme_list).each do |theme| %>
                    <%= theme_chip(theme) %>
                  <% end %>
                </div>
              </td>
              <td class="px-3 py-3">
                <div class="flex flex-wrap gap-2">
                  <%= button_to "Publish", publish_admin_story_path(story, status: @filter), method: :post, class: "rounded-md bg-olive px-2.5 py-1 text-xs text-parchment hover:bg-olive-deep" %>
                  <%= button_to "Hold", hold_admin_story_path(story, status: @filter), method: :post, class: "rounded-md border border-olive/30 px-2.5 py-1 text-xs text-olive hover:bg-parchment" %>
                  <%= button_to "Reject", reject_admin_story_path(story, status: @filter), method: :post, class: "rounded-md border border-rose-800/30 px-2.5 py-1 text-xs text-rose-900 hover:bg-rose-50" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
