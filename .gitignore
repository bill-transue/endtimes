# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore, not here.

/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules

/config/master.key
/config/credentials/*.key
.env
.env.*
!.env.example

/coverage
/public/packs
/public/packs-test
/vendor/bundle
.byebug_history
.DS_Store
/agent-tools
