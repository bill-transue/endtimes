# Copy to .env for local overrides (optional). The app runs without any of these keys.

# GNews search (https://gnews.io). When blank, ingest is RSS-only.
NEWS_API_KEY=

# LLM. Gemini is the default when GEMINI_API_KEY is set.
# Otherwise OPENAI_API_KEY is used. When both are blank, analyses use the mock client.
GEMINI_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=gemini-2.5-flash-lite
# LLM_PROVIDER=gemini

# Admin HTTP basic auth for /admin/stories
ADMIN_USERNAME=admin
ADMIN_PASSWORD=endtimes

# Optional tuning
# DAILY_PUBLISH_CAP=10
# PORT=4317

# Render / production
# DATABASE_URL=postgres://user:pass@host/end_times
# RAILS_MASTER_KEY=
# SECRET_KEY_BASE=
# RAILS_ENV=production
# RAILS_LOG_LEVEL=info
# SOLID_QUEUE_IN_PUMA=
